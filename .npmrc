# The wasm32-wasi fallback binaries pulled in by Tailwind's oxide and Next's
# resolver declare conflicting peers: @napi-rs/wasm-runtime wants
# @emnapi/core@^2.0.0-alpha, while the bindings themselves pin 1.x. npm resolves
# this during `npm install` by overriding the peer, but then writes a lockfile
# that `npm ci` refuses as out of sync -- which breaks every clean install,
# including the Docker image and any CI or platform build.
#
# Those wasm binaries are a fallback for platforms with no native build; they are
# never loaded on the x64/arm64 targets this runs on. Declaring the resolution
# explicitly makes clean installs reproducible instead of leaving it to whatever
# npm happens to do interactively.
legacy-peer-deps=true

# Noise reduction in container and CI builds.
fund=false
audit=false
