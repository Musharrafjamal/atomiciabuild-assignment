# Copy to .env.local for local development outside Docker.
# `docker compose up` supplies these itself -- see docker-compose.yml.

# Single-node replica set locally; an Atlas SRV string in production.
# directConnection=true is required for a single-node replica set.
MONGODB_URI="mongodb://localhost:27017/clinic?replicaSet=rs0&directConnection=true"

# Signing key for the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="dev-only-secret-change-in-production-0123456789abcdef"

# IANA timezone the clinic operates in. Shift dates and times from the CSV are
# interpreted in this zone, then stored as UTC instants.
CLINIC_TZ="Europe/London"

# Run the CSV import automatically when the container boots.
SEED_ON_BOOT="true"

# Set true to wipe and re-import even if the database is already populated.
FORCE_RESEED="false"
