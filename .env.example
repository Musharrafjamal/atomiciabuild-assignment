# Copy to .env.local and fill in your own values.

# MongoDB connection string. Needs a replica set -- the claim engine uses
# multi-document transactions and live updates use change streams, neither of
# which works against a standalone mongod. Any MongoDB Atlas cluster (including
# the free M0 tier) is a replica set.
#
# Include the database name in the path. Atlas hands you a string without one,
# and the driver then silently defaults to a database called "test".
MONGODB_URI="mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/clinic?retryWrites=true&w=majority"

# Optional: overrides the database name when the URI has no path segment.
# MONGODB_DB="clinic"

# Signing key for the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="change-me-to-32-random-bytes-hex"

# IANA timezone the clinic operates in. Dates and times in the CSVs are read as
# local wall-clock in this zone, then stored as UTC instants.
CLINIC_TZ="Asia/Kolkata"

# The same zone, exposed to the browser so client components format dates in the
# clinic's timezone rather than the visitor's. Keep these two in step.
NEXT_PUBLIC_CLINIC_TZ="Asia/Kolkata"

# Set true to wipe and re-import even if the database is already populated.
FORCE_RESEED="false"

# Set true to force the polling fallback instead of live updates.
# NEXT_PUBLIC_DISABLE_LIVE="false"
